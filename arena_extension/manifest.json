{
  "manifest_version": 3,
  "name": "FreeHive Arena Bridge",
  "description": "Arena transport bridge via native messaging host.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://arena.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://arena.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page_bridge.js"
      ],
      "matches": [
        "https://arena.ai/*"
      ]
    }
  ]
}

