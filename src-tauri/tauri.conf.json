{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreeHive",
  "version": "0.1.0",
  "identifier": "com.nazmoney.ilee-ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run build:sidecar",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "ilee_ai",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "sidecar/*",
      "sidecar/**/*",
      "extensions/arena/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
