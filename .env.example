# FreeHive environment variables
# Copy to .env and fill in your values.

# Proxy for Arena adapter (optional — needed for CloakBrowser stealth mode)
ARENA_PROXY=

# Set to 1 to show browser window during Arena sessions (default: headless)
# ARENA_HEADED=1

# Uncomment for headless servers (lower captcha score)
# ARENA_HEADLESS=1
